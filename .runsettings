<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- CodeCoverage configuration -->
  <CodeCoverage>
    <Format>OpenCover</Format>
    <Exclude>
      <ExcludeByAttribute>ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
      <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
      <ExcludeByAttribute>CompilerGeneratedAttribute</ExcludeByAttribute>
      <!-- Exclude test projects -->
      <ExcludeByFile>**/Tests/**</ExcludeByFile>
      <ExcludeByFile>**/test/**</ExcludeByFile>
      <!-- Exclude generated files -->
      <ExcludeByFile>**/*.Designer.cs</ExcludeByFile>
      <ExcludeByFile>**/Migrations/**</ExcludeByFile>
    </Exclude>
    <Include>
      <!-- Include only our main projects -->
      <Include>../src/Market.Domain/**/*.cs</Include>
      <Include>../src/Market.Application/**/*.cs</Include>
      <Include>../src/Market.Infrastructure/**/*.cs</Include>
      <Include>../src/Market.API/**/*.cs</Include>
    </Include>
  </CodeCoverage>
  <LoggerVerbosity>quiet</LoggerVerbosity>
</RunSettings>
